import glob
import os
import signal
import subprocess
import sys
import threading
from collections import OrderedDict

# --- Config ---
PROJECT_NAME = "OS Helper"
SCHEME = "Hex"
PROCESS = "Hex Dev"
SUBSYSTEM = "com.kitlangton.Hex"

# --- Utilities ---

class C:
    """ANSI color codes."""
    RED = "\033[31m"
    GREEN = "\033[32m"
    YELLOW = "\033[33m"
    BLUE = "\033[34m"
    MAGENTA = "\033[35m"
    CYAN = "\033[36m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    RESET = "\033[0m"


def info(msg):
    print(f"{C.CYAN}{msg}{C.RESET}")

def ok(msg):
    print(f"{C.GREEN}{msg}{C.RESET}")

def warn(msg):
    print(f"{C.YELLOW}{msg}{C.RESET}", file=sys.stderr)

def err(msg):
    print(f"{C.RED}{msg}{C.RESET}", file=sys.stderr)


LOG_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "tmp")
LOG_FILE = os.path.join(LOG_DIR, "run.log")

_children = []

def _cleanup_children(signum=None, frame=None):
    for p in _children:
        try:
            p.terminate()
        except OSError:
            pass
    if signum is not None:
        sys.exit(1)

signal.signal(signal.SIGINT, _cleanup_children)
signal.signal(signal.SIGTERM, _cleanup_children)


def run_cmd(cmd, shell=True, capture_log=True):
    """Run a command with line-buffered output, tee to tmp/run.log if capture_log is True."""
    os.makedirs(LOG_DIR, exist_ok=True)
    log_fh = None
    if capture_log:
        log_fh = open(LOG_FILE, "a")

    proc = subprocess.Popen(
        cmd, shell=shell, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        bufsize=1, universal_newlines=True,
    )
    _children.append(proc)
    try:
        for line in proc.stdout:
            sys.stdout.write(line)
            sys.stdout.flush()
            if log_fh:
                log_fh.write(line)
                log_fh.flush()
    finally:
        proc.wait()
        _children.remove(proc)
        if log_fh:
            log_fh.close()
    return proc.returncode


# --- Log predicates ---

def log_predicate(level="app"):
    """Return a macOS `log stream` predicate string for the given level."""
    if level == "app":
        return f"subsystem == '{SUBSYSTEM}'"
    elif level == "debug":
        return (
            f"(subsystem == '{SUBSYSTEM}' OR process == '{PROCESS}') "
            f"AND NOT (subsystem BEGINSWITH 'com.apple.launchservices') "
            f"AND NOT (subsystem BEGINSWITH 'com.apple.runningboard')"
        )
    elif level == "system":
        return f"process == '{PROCESS}' AND subsystem != '{SUBSYSTEM}'"
    elif level == "verbose":
        return f"process == '{PROCESS}'"
    else:
        err(f"Unknown log level: {level}")
        err("Valid levels: app (default), debug, system, verbose")
        sys.exit(1)


def find_app(pattern):
    """Glob for a built .app bundle and return the first match, or None."""
    matches = glob.glob(os.path.expanduser(pattern))
    return matches[0] if matches else None


# --- Command Registry ---

_commands = OrderedDict()

def command(name, description):
    """Decorator to register a command."""
    def decorator(func):
        _commands[name] = {"func": func, "desc": description}
        return func
    return decorator


# --- Commands ---

@command("run", "Build and run (--log LEVEL)")
def cmd_run(args):
    log_level = "app"

    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--log":
            i += 1
            if i >= len(args):
                err("--log requires a level argument")
                sys.exit(1)
            log_level = args[i]
        else:
            err(f"Unknown arg: {arg}")
            sys.exit(1)
        i += 1

    os.makedirs(LOG_DIR, exist_ok=True)
    open(LOG_FILE, "w").close()

    predicate = log_predicate(log_level)

    # Kill existing instance
    subprocess.run(["pkill", "-x", PROCESS], capture_output=True)

    # Delete old app bundle to prevent stale binaries
    pattern = f"~/Library/Developer/Xcode/DerivedData/Hex-*/Build/Products/Debug/{PROCESS}.app"
    old_app = find_app(pattern)
    if old_app:
        info(f"Removing old bundle...")
        subprocess.run(["rm", "-rf", old_app])

    # Clean build
    info("Building...")
    rc = run_cmd(
        f'xcodebuild -scheme "{SCHEME}" -configuration Debug clean build '
        f'2>&1 | grep -E "Compile|BUILD|error:|warning:.*error"'
    )
    print()

    app_path = find_app(pattern)
    if not app_path:
        err("Could not find built app")
        sys.exit(1)

    binary = os.path.join(app_path, "Contents", "MacOS", PROCESS)
    if not os.path.exists(binary):
        err(f"Binary not found: {binary}")
        sys.exit(1)

    info(f"Launching {PROCESS} (direct)")
    info(f"Log level: {log_level}")
    info("Ctrl+C to quit")
    print()

    # Stream logs in background
    log_proc = subprocess.Popen(
        ["log", "stream", "--predicate", predicate, "--level", "debug", "--color", "always"],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        bufsize=1, universal_newlines=True,
    )
    _children.append(log_proc)

    log_fh = open(LOG_FILE, "a")

    def stream_logs():
        try:
            for line in log_proc.stdout:
                sys.stdout.write(line)
                sys.stdout.flush()
                log_fh.write(line)
                log_fh.flush()
        except (IOError, ValueError):
            pass

    log_thread = threading.Thread(target=stream_logs, daemon=True)
    log_thread.start()

    # Run binary directly (not `open`) — dies with Ctrl+C
    app_proc = subprocess.Popen(
        [binary], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        bufsize=1, universal_newlines=True,
    )
    _children.append(app_proc)

    def stream_app():
        try:
            for line in app_proc.stdout:
                sys.stdout.write(line)
                sys.stdout.flush()
                log_fh.write(line)
                log_fh.flush()
        except (IOError, ValueError):
            pass

    app_thread = threading.Thread(target=stream_app, daemon=True)
    app_thread.start()

    # Wait for app to exit
    app_proc.wait()
    _children.remove(app_proc)

    print()
    info(f"Stopping {PROCESS}...")
    log_proc.terminate()
    try:
        log_proc.wait(timeout=3)
    except subprocess.TimeoutExpired:
        log_proc.kill()
    _children.remove(log_proc)
    log_fh.close()


